# Kopier til .env i prosjektroten (leses av backend/db/pool.mjs og collectoren).
# .env er gitignorert — legg ALDRI ekte nøkler i denne filen.

# Lokal database (npm run collect / npm run agent / npm run review)
DATABASE_URL=postgresql://localhost/paaby_dev

# Kilder — en kilde uten nøkkel hoppes over med en melding, resten kjører.
TICKETMASTER_API_KEY=
BILLETTO_API_KEY=
BILLETTO_API_SECRET=
TICKSTER_API_KEY=

# Bildelesing (collector/core/bildeleser.js) — leser plakaten til NYE events
# agenten anbefaler, én gang per event. Uten nøkkel hoppes steget over.
# Azure AI Foundry: nøkkel + OpenAI Responses-endepunktet, f.eks.
# https://<ressurs>.services.ai.azure.com/openai/v1/responses
# BILDELESER_MODELL kan overstyre deployment-navnet (standard: gpt-5.4-mini).
AIFOUNDRY_API_KEY=

FOUNDRY_ENDPOINT=

# Review-serveren (npm run review)
SESSION_SECRET=
